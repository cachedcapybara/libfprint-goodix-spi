# pixman is pulled in by the aes3k imaging helper.  install.sh does not list it
# in its preflight, but the unmodified upstream driver set needs it, and the
# driver set must stay complete: our udev rule shadows the distribution one.
 libpixman-1-dev,
 libssl-dev (>= 3.0),
# fprintd build dependencies: polkit-gobject-1 is required by the patched
# daemon, gettext for its translations.
 libpolkit-gobject-1-dev,
 gettext,
# strips a build-tree RPATH from the shadow fprintd binary.
 patchelf,
